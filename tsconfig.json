{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "isolatedModules": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,

    // Il codice nuovo e' TS strict senza `any`: e' il contratto con l'API futura
    // (CLAUDE.md §3). Le pagine ereditate sono .jsx: compilano, ma non si
    // dichiarano tipizzate. Entrano sotto controllo quando M3 le converte.
    "strict": true,
    "allowJs": true,
    "checkJs": false,

    // Esplicito: rinominando jsconfig.json in tsconfig.json si perde il noEmit
    // implicito, e senza questo `npm run typecheck` scrive .js accanto ai sorgenti.
    "noEmit": true,

    // I guardrail del §5.6 girano su import.meta.env.DEV: senza vite/client
    // TypeScript non sa che import.meta ha `env`.
    "types": ["vite/client"],

    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "reference"]
}
